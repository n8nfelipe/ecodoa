# ===== Servidor =====
PORT=3333
NODE_ENV=development
BASE_URL=http://localhost:3333

# ===== Banco de Dados =====
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/reciclagem?schema=public"

# ===== Autenticação =====
JWT_SECRET="troque-este-segredo-em-producao"
JWT_EXPIRES_IN="7d"

# ===== Google OAuth (opcional) =====
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3333/api/auth/google/callback

# ===== Uploads =====
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5