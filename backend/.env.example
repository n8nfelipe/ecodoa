# ===== Servidor =====
PORT=3333
NODE_ENV=development
BASE_URL=http://localhost:5173

# ===== Banco de Dados =====
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/reciclagem?schema=public"

# ===== Autenticação =====
JWT_SECRET="troque-este-segredo-em-producao"
JWT_EXPIRES_IN="7d"

# ===== Recuperação de senha =====
PASSWORD_RESET_TOKEN_MINUTES=30
PASSWORD_RESET_EXPOSE_LINK=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=iafelipemoura@gmail.com
SMTP_PASS=
MAIL_FROM="EcoDoa <iafelipemoura@gmail.com>"

# ===== Google OAuth (opcional) =====
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3333/api/auth/google/callback

# ===== Uploads =====
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5
